# Stage 01 development configuration. These are placeholders, not usable credentials.
# Copy to an ignored .env, restrict its permissions, and load it into the environment.
# Settings do not automatically load .env. Never commit the completed file.
SKYBEAT_ENV=development
SKYBEAT_DATABASE_URL=mysql+pymysql://skybeat:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:3306/skybeat_dev?charset=utf8mb4
SKYBEAT_PUBLIC_BASE_URL=http://localhost:8000
SKYBEAT_ALLOWED_HOSTS=localhost,127.0.0.1
SKYBEAT_ENABLE_API_DOCS=false
SKYBEAT_LOG_LEVEL=INFO

# All database network, pool, lock and SELECT waits are bounded.
SKYBEAT_DB_POOL_SIZE=5
SKYBEAT_DB_MAX_OVERFLOW=5
SKYBEAT_DB_POOL_TIMEOUT_SECONDS=2
SKYBEAT_DB_CONNECT_TIMEOUT_SECONDS=3
SKYBEAT_DB_READ_TIMEOUT_SECONDS=3
SKYBEAT_DB_WRITE_TIMEOUT_SECONDS=3
SKYBEAT_DB_LOCK_TIMEOUT_SECONDS=1
SKYBEAT_DB_SELECT_TIMEOUT_MS=3000

# Stage 03 worker and SMTP notification configuration. Leave recipients empty until
# protected SMTP configuration and approved server-controlled recipients are available.
SKYBEAT_HEALTH_SWEEP_SECONDS=5
SKYBEAT_NOTIFICATION_POLL_SECONDS=5
SKYBEAT_NOTIFICATION_CONCURRENCY=4
SKYBEAT_ALERT_EMAIL_RECIPIENTS=
SKYBEAT_SMTP_HOST=
SKYBEAT_SMTP_PORT=587
SKYBEAT_SMTP_USERNAME=
SKYBEAT_SMTP_PASSWORD=REPLACE_WITH_PROTECTED_SECRET
SKYBEAT_SMTP_FROM_ADDRESS=

# Stage 05 SMS stays provider-neutral. Enable only to queue server-controlled
# E.164 recipients; without a separately approved adapter, the worker records
# a safe no-op failure and makes no external SMS call.
SKYBEAT_SMS_ENABLED=false
SKYBEAT_ALERT_SMS_RECIPIENTS=

# Stage 04 dashboard authentication. Google credentials and the Fernet key are
# protected runtime secrets; do not use these placeholders as real values.
SKYBEAT_ALLOWED_EMAILS=
SKYBEAT_ALLOWED_DOMAINS=
SKYBEAT_GOOGLE_CLIENT_ID=
SKYBEAT_GOOGLE_CLIENT_SECRET=REPLACE_WITH_PROTECTED_SECRET
SKYBEAT_SESSION_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
SKYBEAT_OIDC_TIMEOUT_SECONDS=5

# Production later requires SKYBEAT_ENV=production, an explicit HTTPS origin,
# an exact host allowlist, protected secrets and the approved deployment controls.
# This file is not a production deployment configuration.
