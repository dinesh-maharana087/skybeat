# Stage 01 development configuration. These are placeholders, not usable credentials.
# Copy to an ignored .env, restrict its permissions, and load it into the environment.
# Settings do not automatically load .env. Never commit the completed file.
SKYBEAT_ENV=development
SKYBEAT_DATABASE_URL=mysql+pymysql://skybeat_runtime:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:3306/skybeat_dev?charset=utf8mb4
SKYBEAT_PUBLIC_BASE_URL=http://localhost:8000
SKYBEAT_ALLOWED_HOSTS=localhost,127.0.0.1
SKYBEAT_ENABLE_API_DOCS=false
SKYBEAT_LOG_LEVEL=INFO

# Stage 06 Docker Compose inputs. Copy these to a protected, ignored `.env`
# on the central VM; do not use the placeholders in production. The migration
# URL must use a separate scoped migration account, never MySQL root.
SKYBEAT_MYSQL_DATABASE=skybeat
SKYBEAT_MYSQL_RUNTIME_USER=skybeat_runtime
SKYBEAT_MYSQL_RUNTIME_PASSWORD=REPLACE_WITH_PROTECTED_SECRET
SKYBEAT_MYSQL_MIGRATION_USER=skybeat_migration
SKYBEAT_MYSQL_MIGRATION_PASSWORD=REPLACE_WITH_PROTECTED_SECRET
SKYBEAT_MYSQL_ROOT_PASSWORD=REPLACE_WITH_PROTECTED_SECRET
SKYBEAT_MIGRATION_DATABASE_URL=mysql+pymysql://skybeat_migration:REPLACE_WITH_URL_ENCODED_PASSWORD@mysql:3306/skybeat?charset=utf8mb4
SKYBEAT_CADDY_HOST=monitor.example.com

# All database network, pool, lock and SELECT waits are bounded.
SKYBEAT_DB_POOL_SIZE=5
SKYBEAT_DB_MAX_OVERFLOW=5
SKYBEAT_DB_POOL_TIMEOUT_SECONDS=2
SKYBEAT_DB_CONNECT_TIMEOUT_SECONDS=3
SKYBEAT_DB_READ_TIMEOUT_SECONDS=3
SKYBEAT_DB_WRITE_TIMEOUT_SECONDS=3
SKYBEAT_DB_LOCK_TIMEOUT_SECONDS=1
SKYBEAT_DB_SELECT_TIMEOUT_MS=3000
SKYBEAT_SUSPECT_AFTER_SECONDS=75
SKYBEAT_OFFLINE_AFTER_SECONDS=180

# Stage 03 worker and SMTP notification configuration. Leave recipients empty until
# protected SMTP configuration and approved server-controlled recipients are available.
SKYBEAT_HEALTH_SWEEP_SECONDS=5
SKYBEAT_NOTIFICATION_POLL_SECONDS=2
SKYBEAT_NOTIFICATION_CONCURRENCY=4
SKYBEAT_ALERT_EMAIL_RECIPIENTS=
SKYBEAT_SMTP_HOST=
SKYBEAT_SMTP_PORT=587
SKYBEAT_SMTP_USERNAME=
SKYBEAT_SMTP_PASSWORD=REPLACE_WITH_PROTECTED_SECRET
SKYBEAT_SMTP_FROM_ADDRESS=

# Stage 05 SMS stays provider-neutral. Enable only to queue server-controlled
# E.164 recipients; without a separately approved adapter, the worker records
# a safe no-op failure and makes no external SMS call.
SKYBEAT_SMS_ENABLED=false
SKYBEAT_ALERT_SMS_RECIPIENTS=

# -------------------------------------------------------------------
# Google OIDC dashboard authentication
# -------------------------------------------------------------------
# Use a Google Cloud OAuth 2.0 Web application client. These values are
# required for real Google login; production also requires a valid Fernet key.
# Store real credentials only in protected local/production configuration.
# Never commit a real Google client secret.
SKYBEAT_GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_WEB_CLIENT_ID
SKYBEAT_GOOGLE_CLIENT_SECRET=REPLACE_WITH_PROTECTED_GOOGLE_CLIENT_SECRET

# Public origin used to construct the server-side authorization-code callback.
# Local development callback URI: http://localhost:8000/auth/google/callback
# This server-side OIDC flow has no browser Google JavaScript client, so no
# Authorized JavaScript Origin is required for this callback flow.
SKYBEAT_PUBLIC_BASE_URL=http://localhost:8000

# Admit verified Google identities by an exact email and/or Google Workspace
# hosted domain. At least one comma-delimited list must be non-empty for real
# login; entries are trimmed, lowercased, and deduplicated. Admission does not
# assign a SkyBeat role: roles come only from application_users. Create the
# initial Owner separately with:
# python -m app.cli --actor <operator> owner-bootstrap --email <YOUR_ADMIN_EMAIL>
SKYBEAT_ALLOWED_EMAILS=admin@example.com
SKYBEAT_ALLOWED_DOMAINS=

# Local-development browser testing only. Keep false for real Google login;
# the bypass requires SKYBEAT_ENV=development and is rejected in production.
SKYBEAT_DEV_AUTH_BYPASS=false

# Encrypts server-side OAuth transaction state. Use a valid protected Fernet
# key; never commit the real value.
SKYBEAT_SESSION_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY

# Bound for Google discovery/token operations, in seconds.
SKYBEAT_OIDC_TIMEOUT_SECONDS=5
SKYBEAT_AGENT_ENROLLMENT_TTL_SECONDS=600
SKYBEAT_AGENT_ENROLLMENT_VERIFICATION_TTL_SECONDS=600

# Production later requires SKYBEAT_ENV=production, an explicit HTTPS origin,
# an exact host allowlist, protected secrets and the approved deployment controls.
# This file is not a production deployment configuration.
